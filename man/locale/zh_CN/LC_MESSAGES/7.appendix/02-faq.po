#: 57a273ec538549c9a1f7b537ac292be5
msgid "File"
msgstr "文件"

#: ../../../Users/walterfan/workspace/walter/freeswitch_primer/man/7.appendix/02-faq.md
#: 0e4163aededb4d1aaf8bb502fd7b7147
msgid "When"
msgstr "时机"

#: ../../../Users/walterfan/workspace/walter/freeswitch_primer/man/7.appendix/02-faq.md
